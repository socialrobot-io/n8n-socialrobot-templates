    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const ready = String(item.json.ready || '').toLowerCase();\n  const due = item.json.date && new Date(item.json.date).getTime() > Date.now();\n  if ((ready === 'yes' || ready === 'true' || ready === 'ready') && due) out.push(item);\n}\nreturn out;"
      },
