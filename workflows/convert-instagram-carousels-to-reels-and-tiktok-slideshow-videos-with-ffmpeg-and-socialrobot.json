      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Build ffmpeg Command').first().json.output_file }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "baca4f97-1e53-4c17-8adc-8712cdc80fe8",
      "name": "Read Reel from Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2800,
        400
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Checks the file before it goes to SocialRobot. Duration comes from the MP4 header (mvhd box).\nconst s = $('Set Render Settings').first().json;\nconst item = $input.first();\nconst video = item.binary && item.binary.data;\nconst problems = [];\nlet sizeMb = 0;\nlet seconds = null;\nif (!video) {\n  problems.push('No video file was downloaded.');\n} else {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  sizeMb = buf.length / 1048576;\n  const i = buf.indexOf('mvhd');\n  if (i > 3) {\n    const v1 = buf[i + 4] === 1;\n    const scale = buf.readUInt32BE(i + (v1 ? 24 : 16));\n    const units = v1 ? Number(buf.readBigUInt64BE(i + 28)) : buf.readUInt32BE(i + 20);\n    if (scale) seconds = Math.round((units / scale) * 10) / 10;\n  }\n  if (sizeMb > Number(s.max_file_mb)) problems.push(`File is ${sizeMb.toFixed(1)} MB, above the ${s.max_file_mb} MB limit.`);\n  if (seconds === null) problems.push('Could not read the video duration.');\n  else if (seconds < Number(s.min_seconds) || seconds > Number(s.max_seconds)) problems.push(`Video is ${s.min_seconds}-${s.max_seconds} s; allowed is ${s.min_seconds}-${s.max_seconds} s.`);\n}\nreturn [{ json: { ok: problems.length === 0, problems, size_mb: Math.round(sizeMb * 100) / 100, duration_seconds: seconds }, binary: item.binary }];"
