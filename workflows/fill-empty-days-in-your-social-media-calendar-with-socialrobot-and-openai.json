    {
      "parameters": {
        "jsCode": "// One alert listing every newly failed post. Only `id` is guaranteed; other fields are shown when present.\nconst esc = s => String(s ?? '').replace(/[<>&]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));\nconst rows = $input.all().map(({ json: p }) => {\n  const where = [].concat(p.platform ?? p.platforms ?? []).join(', ');\n  const text = String(p.caption ?? p.content ?? p.text ?? '').slice(0, 80);\n  const why = p.error ?? p.errorMessage ?? p.failureReason ?? '';\n  return `<li><b>${esc(p.id)}</b> ${esc(where)} ${esc(text)} ${why ? '<i>' + esc(why) + '</i>' : ''}</li>`;\n});\nreturn [{ json: {\n  count: rows.length,\n  subject: `${rows.length} social post(s) failed in SocialRobot`,\n  html: `<p>These posts failed to publish. Open SocialRobot to fix and reschedule them.</p><ul>${rows.join('')}</ul>`,\n  text: `${rows.length} post(s) failed in SocialRobot: ` + $input.all().map(i => i.json.id).join(', '),\n} }];"
      },
