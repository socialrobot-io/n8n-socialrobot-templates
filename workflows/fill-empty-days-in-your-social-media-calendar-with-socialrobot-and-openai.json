    {
      "parameters": {
        "jsCode": "// One item per upcoming day, in the workflow time zone.\nconst o = $input.first().json;\nconst [hour, minute] = String(o.post_time || '10:00').split(':').map(Number);\nconst pillars = String(o.content_pillars || '').split(';').map(p => p.trim()).filter(Boolean);\nconst skip = String(o.skip_weekdays || '').toLowerCase();\nconst days = [];\nfor (let i = 1; i <= Number(o.days_ahead || 7); i++) {\n  const day = $now.plus({ days: i }).startOf('day');\n  if (skip.includes(day.toFormat('ccc').toLowerCase())) continue;\n  days.push({ json: {\n    date: day.toFormat('yyyy-MM-dd'),\n    weekday: day.toFormat('cccc'),\n    day_start: day.toUTC().toISO({ suppressMilliseconds: true }),\n    day_end: day.endOf('day').toUTC().toISO({ suppressMilliseconds: true }),\n    publish_at: day.set({ hour, minute }).toISO({ suppressMilliseconds: true }),\n    pillar: pillars.length ? pillars[day.ordinal % pillars.length] : 'General update',\n  } });\n}\nreturn days;"
      },
      "id": "b5e8f1f8-f7af-4ebe-8e5d-4beb306259b6",
