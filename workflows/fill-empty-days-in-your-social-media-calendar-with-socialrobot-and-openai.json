    {
      "parameters": {
        "jsCode": "// SocialRobot returns each day's posts paired with the day that asked for them.\n// A day with no matching post is empty.\nconst busy = new Set();\n$input.all().forEach((item, i) => {\n  if (!item.json.id) return; // placeholder item when nothing is scheduled at all\n  busy.add($('List Upcoming Days').itemMatching(i).json.date);\n});\nreturn $('List Upcoming Days').all().filter(day => !busy.has(day.json.date)).map(day => ({ json: day.json }));"
      },
      "id": "dbe29f64-b5d7-4a9e-b89e-2be5182181b9",
