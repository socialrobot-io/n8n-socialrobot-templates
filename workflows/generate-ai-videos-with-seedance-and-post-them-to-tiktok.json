    {
      "parameters": {
        "text": "=You are a short-form video director. Turn the topic below into one vivid,\nconcrete video generation prompt for an AI text-to-video model. Describe the\nscene, camera movement, lighting, and mood in one flowing paragraph of at most\n120 words. No camera jargon a model would not understand. Return only the prompt.\n\nTopic: {{ $json.topic }}",
        "options": {
          "systemMessage": "=You always follow the output schema exactly."
        },
        "promptType": "define"
      },
      "id": "3efb5104-419a-45d3-aef0-5e2e7edb085c",
      "name": "AI Video Prompt Writer",
