    },
    {
      "parameters": {
        "text": "=You are a content repurposing expert. Turn the long-form content below into a platform-native post for each platform.\n\nSource content:\n{{ $json.content }}\n\nGuidelines:\n- X (Twitter): under 280 characters, punchy, 2-3 hashtags.\n- LinkedIn: professional, 3-4 short lines, end with a question or CTA.\n- Facebook: friendly and conversational, 2-3 sentences.\n- Bluesky: under 300 characters, warm and authentic.\n- Mastodon: thoughtful, can be longer, include 2-3 hashtags.\n- Threads: casual, 1-2 sentences.\n\nReturn plain text with no markdown.",
        "options": {
          "systemMessage": "=You always follow the output schema exactly."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "id": "e656e837-726d-4f32-88f7-4751f16a1917",
      "name": "AI Repurposing Engine",
      "type": "@n8n/n8n-nodes-langchain.agent",
