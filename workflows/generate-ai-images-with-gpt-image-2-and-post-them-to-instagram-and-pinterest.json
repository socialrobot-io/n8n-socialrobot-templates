      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"gpt-image-2\", \"prompt\": \"{{ $json.imagePrompt }}\", \"size\": \"1536x1024\", \"quality\": \"high\", \"n\": 1}",
