    {
      "parameters": {
        "text": "=You are a social media writer. Write a fresh, original post for Bluesky and Mastodon about the theme below. Vary the angle and wording each run so posts never repeat.\n\nTheme: {{ $json.theme }}\n\nGuidelines:\n- Bluesky: under 300 characters, warm and authentic, 1-2 hashtags.\n- Mastodon: thoughtful, can be longer, 2-3 hashtags.\n\nReturn plain text with no markdown.",
        "options": {
          "systemMessage": "=You always follow the output schema exactly."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
