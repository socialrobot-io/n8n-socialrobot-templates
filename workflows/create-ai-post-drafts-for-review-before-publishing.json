      "id": "976d52ca-a9ac-4f5e-8912-361a4e29f1bd",
      "name": "Set post theme",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        360
      ]
    },
    {
      "parameters": {
        "text": "=You are a social media writer. Write one post for each platform below about the theme. Vary the angle and wording each run so drafts never repeat.\n\nTheme: {{ $json.theme }}\n\nGuidelines:\n- Instagram: catchy caption with 3-5 hashtags.\n- X (Twitter): under 280 characters, punchy, 2-3 hashtags.\n- LinkedIn: professional, 3-4 short lines, end with a question or CTA.\n- TikTok: short and energetic with 3-5 hashtags.\n- Facebook: friendly and conversational, 2-3 sentences.\n- Pinterest title: under 100 characters, keyword-rich.\n- Pinterest description: 2-3 sentences with keywords.\n- Bluesky: under 300 characters, warm and authentic.\n- Mastodon: thoughtful, can be longer, include 2-3 hashtags.\n- Threads: casual, 1-2 sentences.\n\nReturn plain text with no markdown formatting.",
        "options": {
          "systemMessage": "=You always follow the output schema exactly."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "id": "f742c9cf-7d6c-4b07-8d5e-1df133122b58",
