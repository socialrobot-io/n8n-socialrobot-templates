      "parameters": {
        "jsCode": "// One item per product photo. The form stores each upload in its own binary field.\nconst s = $('Set Video Settings').first().json;\nconst form = $('Product Video Form').first();\nconst photos = Object.values(form.binary || {}).filter(b => String(b.mimeType || '').startsWith('image/'));\nif (!photos.length) throw new Error('Add at least one product photo (JPG, PNG or WebP).');\nreturn photos.slice(0, Number(s.max_photos) || 4).map((photo, i) => ({\n  json: { photo_number: i + 1, file_name: photo.fileName },\n  binary: { photo },\n}));"
      },
