    {
      "parameters": {
        "jsCode": "// Replicate input for Seedance 2.5. Other models may use different field names: check the model's API tab.\nconst s = $('Set Video Settings').first().json;\nconst script = $json.output;\nreturn [{ json: {\n  model: s.model,\n  body: { input: {\n    prompt: script.seedance_prompt,\n    reference_images: $('Collect Photo URLs').first().json.photo_urls,\n    duration: Number(s.duration_seconds),\n    resolution: s.resolution,\n    aspect_ratio: s.aspect_ratio,\n    generate_audio: s.generate_audio === true || s.generate_audio === 'true',\n    watermark: false,\n  } },\n} }];"
      },
